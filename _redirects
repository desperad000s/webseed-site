# Cloudflare Pages reads this file natively. Format:
#   /from  /to  status   (200 = proxy, 301/302/308 = redirect)

# /api/event is now handled by functions/api/event.js (CF Pages Function),
# which proxies POSTs to Plausible AND returns 204 for OPTIONS / other
# methods so Lighthouse doesn't see "405 Method Not Allowed" in the
# browser console.

# Pages auto-serves /foo.html at /foo (and 308s /foo.html → /foo
# for SEO). Don't add explicit /contact → /contact.html rules —
# they create a redirect loop with the auto-resolver.

# German alias for the imprint + privacy pages
/imprint           /impressum.html   200
/datenschutz       /privacy.html     200

# Custom blog post slug → underlying file
/blog/why-launch-isnt-the-finish-line   /blog-post.html   200

# Trailing-slash variants for the aliases above
/imprint/          /impressum.html   200
/datenschutz/      /privacy.html     200
